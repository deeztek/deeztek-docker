#!/bin/sh
#
# Run by ofelia inside the docker:cli image, which is Alpine and has no bash.
# Keep this POSIX sh.

BASE=/opt/nextcloud-spreed-signaling

#Attempt Renewal
echo 'Attempting renewal'

RENEWAL=`docker run --rm --name certbot \
  -v $BASE/nginx/conf/www:/var/www/certbot \
  -v $BASE/certbot/conf/:/etc/letsencrypt \
  -v $BASE/certbot/logs:/var/log/letsencrypt \
  certbot/certbot:latest renew --webroot --webroot-path /var/www/certbot/`

echo "$RENEWAL"

if echo "$RENEWAL" | grep -q 'Congratulations'; then

echo 'Certificate was renewed. Copying Certificates and Restarting Containers'

#Copy certificate and private key to coturn
cp $BASE/certbot/conf/live/SIGNALFQDN/fullchain.pem $BASE/coturn/fullchain.pem && \
cp $BASE/certbot/conf/live/SIGNALFQDN/privkey.pem $BASE/coturn/privkey.pem && \

#Set certificate and key permissions. 0755 on the directory so the coturn
#container can traverse it, 0644 on the files themselves. A recursive 0644
#would strip +x from the directory.
chmod 0755 $BASE/coturn && \
chmod 0644 $BASE/coturn/fullchain.pem $BASE/coturn/privkey.pem && \

#Restart Containers
docker container restart nextcloud_spreed_nginx && \
docker container restart nextcloud_spreed_coturn

else

echo 'Certificate was not renewed'

fi
