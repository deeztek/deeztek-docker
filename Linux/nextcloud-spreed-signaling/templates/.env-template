SIGNAL_FQDN=SIGNALFQDN
STATIC_SECRET=STATICSECRET

# Public IP ADVERTISED to clients. Used by Janus (--nat-1-1) and coturn
# (--external-ip) so ICE candidates and TURN relay addresses are reachable from
# the internet instead of being container-internal addresses. If this host is
# behind 1:1 NAT, this is the public side of the NAT.
PUBLIC_IP=PUBLICIP

# BIND_IP: host address that published ports BIND to, for hosts with multiple
# public IPs. Set this to the single IP the signaling FQDN resolves to so the
# stack does not claim ports on the others. This block and the "${BIND_IP}:"
# prefix on every port mapping are both removed by the installer if you chose
# to publish on all interfaces.
BIND_IP=BINDIP

# UDP port ranges. These are published as identity mappings and must not
# overlap. Firewall both ranges open. Roughly one port per media stream, so
# ~100 ports covers a small deployment; widen if you run large calls.
JANUS_RTP_MIN=20000
JANUS_RTP_MAX=20099
TURN_RELAY_MIN=49160
TURN_RELAY_MAX=49200

TIMEZONE="America/New_York"
