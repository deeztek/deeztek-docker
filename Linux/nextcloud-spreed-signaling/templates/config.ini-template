[job-run "certbot-renew"]
schedule = 0 30 01 * * *
command = /opt/nextcloud-spreed-signaling/scripts/certbot_renew.sh
image = docker:cli
volume = /var/run/docker.sock:/var/run/docker.sock
volume = /opt/nextcloud-spreed-signaling/scripts:/opt/nextcloud-spreed-signaling/scripts
# certbot_renew.sh copies the renewed certificate from certbot/conf/live into
# coturn/, so both paths must exist inside the job container as well.
volume = /opt/nextcloud-spreed-signaling/certbot:/opt/nextcloud-spreed-signaling/certbot
volume = /opt/nextcloud-spreed-signaling/coturn:/opt/nextcloud-spreed-signaling/coturn
